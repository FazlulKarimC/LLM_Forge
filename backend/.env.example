# ============================================================
# LlmForge Backend - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- Database (NeonDB - free tier) --- REQUIRED
DATABASE_URL='postgresql://user:password@ep-xxx.region.neon.tech/dbname?sslmode=verify-full'

# Runtime pool (no new infrastructure); use the direct Neon URL for migrations.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
DB_POOL_TIMEOUT=10

# --- Vector Database (Qdrant - for RAG) ---
# QDRANT_URL="https://your-cluster.qdrant.tech"
# QDRANT_API_KEY="your-qdrant-api-key"

# --- CORS / Security ---
# Comma-separated list of allowed origins. Add your Vercel/frontend domain here.
# CORS_ORIGINS="http://localhost:3000,https://your-frontend.vercel.app"

# --- HuggingFace Inference API (free tier) ---
HF_TOKEN='hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'

# --- Inference Engine ---
# Options: 'mock' (local testing, no API calls) | 'hf_api' (real HF inference)
INFERENCE_ENGINE='mock'

# --- Background Jobs (Upstash Redis - free tier) --- OPTIONAL
# Upstash archives inactive instances after 14 days. In auto mode,
# the app detects this and falls back to inline execution automatically.
# UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"
# REDIS_URL="rediss://default:your-token@your-instance.upstash.io:6379"

# --- Task Dispatch ---
# auto: optional RQ when Upstash and a worker are available
# upstash: always try RQ (fail hard if unavailable)
# inline: recommended personal deployment; no Redis or worker required
QUEUE_BACKEND_MODE="inline"

# Hosted benchmark budgets (application limits, not provider/account quotas).
BENCHMARK_MAX_SAMPLES=20
BENCHMARK_MAX_CALLS=20
BENCHMARK_MAX_SECONDS=300
BENCHMARK_CALL_TIMEOUT_SECONDS=30
BENCHMARK_REACT_MAX_SAMPLES=5
BENCHMARK_REACT_MAX_ITERATIONS=3
# UPSTASH_CIRCUIT_OPEN_MINUTES=30
# UPSTASH_HEALTHCHECK_TIMEOUT_MS=1500
# UPSTASH_HEALTHCHECK_CACHE_SECONDS=60
# RQ_WORKER_HEARTBEAT_INTERVAL_SECONDS=30
# RQ_WORKER_HEARTBEAT_TTL_SECONDS=90

# Clerk session verification (same application as the frontend)
CLERK_ISSUER_URL=https://YOUR_APPLICATION.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Hosted: https://llmforge.vercel.app (exact origin, no trailing slash/path).
# Optional networkless verification PEM and audience:
# CLERK_JWT_PUBLIC_KEY=
# CLERK_AUDIENCE=

# Legacy dataset authoring is retired. Enable only for compatibility tools.
# LEGACY_DATASET_WRITES=false
